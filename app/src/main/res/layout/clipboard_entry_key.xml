<?xml version="1.0" encoding="utf-8"?>
<!-- Murmur: clipboard card from design/mockups.html (text, then a footer with pin and age) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="62dp"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:hapticFeedbackEnabled="false"
    android:soundEffectsEnabled="false">
    <ImageView
        android:id="@+id/clipboard_entry_image_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:visibility="gone"/>
    <TextView
        android:id="@+id/clipboard_entry_text_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:lineSpacingMultiplier="1.1"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/clipboard_entry_pinned_icon"
            android:contentDescription="@string/clipboard_history_pinned_first"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:id="@+id/clipboard_entry_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
